    {
      "name": "04 - External exchange rates",
      "item": [
        {
          "name": "Frankfurter USD to MYR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const d=pm.response.json(); pm.test(\"Exchange rate fields\", () => { pm.expect(d.base).to.eql(\"USD\"); pm.expect(d.quote).to.eql(\"MYR\"); pm.expect(Number(d.rate)).to.be.above(0); pm.expect(d.date).to.be.a(\"string\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/exchange-rates/USD/MYR",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "exchange-rates",
                "USD",
                "MYR"
              ]
            },
            "description": "Requires internet access and a working Frankfurter provider."
          },
          "response": []
