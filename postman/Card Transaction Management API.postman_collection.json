  "item": [
    {
      "name": "02 - Transactions: positive flow",
      "item": [
        {
          "name": "Create transaction (saves transactionId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"ID and pending status\", () => { pm.expect(data.id).to.be.a(\"number\"); pm.expect(data.status).to.eql(\"PENDING\"); });",
                  "if (data.id != null) { pm.collectionVariables.set(\"transactionId\", String(data.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantName\": \"Postman Demo Merchant\",\n  \"amount\": 125.5,\n  \"currency\": \"MYR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ]
            },
            "description": "Run this first to automatically save the created ID as a collection variable."
          },
          "response": []
        },
        {
          "name": "Get created transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const d = pm.response.json(); pm.test(\"ID matches\", () => pm.expect(String(d.id)).to.eql(pm.collectionVariables.get(\"transactionId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "{{transactionId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update created transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Updated status and amount\", () => { const d=pm.response.json(); pm.expect(d.status).to.eql(\"APPROVED\"); pm.expect(Number(d.amount)).to.eql(250.75); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantName\": \"Updated Postman Merchant\",\n  \"amount\": 250.75,\n  \"currency\": \"MYR\",\n  \"status\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "{{transactionId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List transactions page 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const d=pm.response.json(); pm.test(\"Exactly configured page size\", () => { pm.expect(d.size).to.eql(10); pm.expect(d.content).to.be.an(\"array\"); pm.expect(d.content.length).to.be.at.most(10); pm.expect(d.page).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?page=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "List transactions page 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const d=pm.response.json(); pm.test(\"Next page\", () => { pm.expect(d.size).to.eql(10); pm.expect(d.page).to.eql(1); pm.expect(d.content.length).to.be.at.most(10); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/transactions?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        }
      ]
